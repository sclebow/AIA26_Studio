{
  "_meta": {
    "notes": "Static material properties for architectural advice. GWP fallback values are reference averages from EPD literature (kgCO2e per declared unit). fire_rating is an object with six regional standards. Life cycle years follow ISO 15686 reference service life. ec3_category maps to Building Transparency EC3 API category names.",
    "sources": "EN 13501-1/2, ASTM E84/E119/E152, BS 476-7/20/21/22, GB 8624/50016/12955, CAN/ULC-S102/S101/S104, AS/NZS 1530/AS 1905.1, ISO 15686, RICS service life data, ICE Database v3, typical EPD averages",
    "fire_rating_standards": {
      "EN_13501": "EN 13501-1 for finishes (A1/A2/B/C/D); EN 13501-2 for structural (REI minutes) and doors (EI minutes) — Europe, Middle East, most of Asia",
      "ASTM_E84": "ASTM E84 for finishes (Class A/B/C); ASTM E119 for structural (hour rating); ASTM E152 for doors — USA, Canada shares CAN/ULC-S102",
      "BS_476": "BS 476-7 for finishes (Class 1-4); BS 476-20/21 for structural; BS 476-22 for doors (FD rating) — UK and Commonwealth",
      "GB_8624": "GB 8624 for finishes (A1/A2/B1/B2/B3); GB 50016 for structural; GB 12955 for doors — China",
      "CAN_ULC": "CAN/ULC-S102 for finishes (Class A/B/C); ULC-S101 for structural (hour rating); ULC-S104 for doors — Canada",
      "AS_NZS": "AS/NZS 1530.3 for finishes (Group 1-4); AS 1530.4 for structural (minutes); AS 1905.1 for doors (FD rating) — Australia and New Zealand"
    }
  },

