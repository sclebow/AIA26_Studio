# Team 04 local runtime settings template.
# The canonical runtime loads the repository root .env first.
# If no repo-level .env exists, copy this file to team_04/.env and fill in the values you need.

LLM_PROVIDER = "cloudflare"

# Local OpenAI-compatible server (LM Studio, Ollama, etc.)
LOCAL_LLM_ENDPOINT = "http://localhost:1234/v1/"
LOCAL_MODEL = "local"

# Google
GOOGLE_API_KEY = "your_google_api_key"
GOOGLE_MODEL = "gemini-2.5-flash-lite"

# Cloudflare Workers AI
CF_ACCOUNT_ID = "your_cloudflare_account_id"
CF_API_TOKEN = "your_cloudflare_api_token"
CF_MODEL = "@cf/qwen/qwen3-30b-a3b-fp8"

# OpenAI
OPENAI_API_KEY = "your_openai_api_key"
OPENAI_MODEL = "gpt-5-nano"

# Anthropic
ANTHROPIC_API_KEY = "your_anthropic_api_key"
ANTHROPIC_MODEL = "claude-haiku-4-5"

# Team 04 runtime behavior
REQUEST_TIMEOUT_SECONDS = "300"
MAX_OPTIMIZATION_CYCLES = "4"

# Optional Team 04 benchmarking overrides.
# Leave blank to reuse the default provider and model above.
TEAM04_DECISION_LLM_PROVIDER = ""
TEAM04_DECISION_LLM_MODEL = ""
TEAM04_REPORT_LLM_PROVIDER = ""
TEAM04_REPORT_LLM_MODEL = ""

# MCP endpoint configuration is read from mcp.json at the repo root if present,
# otherwise from team_04/mcp.example.json.