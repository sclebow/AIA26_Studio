<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TerraPilot</title>
  <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" />
  <link rel="stylesheet" href="/static/style-vscode.css?v=6" />
  <link rel="stylesheet" href="/static/style.css?v=4" />
  <style>
    /* Workflow Layout CSS */
    .workflow-layout { display: grid; grid-template-columns: 200px 1fr 350px; width: 100vw; height: 100vh; background-color: #1e1e1e; color: #cccccc; overflow: hidden; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    .left-sidebar { background-color: #252526; border-right: 1px solid #3e3e42; display: flex; flex-direction: column; overflow: hidden; }
    .tab-navigation { display: flex; flex-direction: column; gap: 5px; padding: 10px; flex-shrink: 0; }
    .shape-panel { flex: 1; border-top: 1px solid #3e3e42; overflow-y: auto; display: none; }
    .shape-panel.active { display: flex; }
    .shape-panel-content { display: flex; flex-direction: column; gap: 8px; padding: 12px; width: 100%; }
    .shape-panel-label { font-size: 11px; font-weight: 600; color: #858585; text-transform: uppercase; padding: 4px 0; }
    .shape-folders-list { display: flex; flex-direction: column; gap: 4px; }
    .shape-folder-btn { width: 100%; padding: 10px 12px; background: transparent; border: 1px solid #3e3e42; color: #cccccc; cursor: pointer; text-align: left; font-size: 12px; border-radius: 3px; transition: all 0.2s ease; }
    .shape-folder-btn:hover { background-color: #2d2d30; border-color: #007acc; color: #007acc; }
    .tab-btn { display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: transparent; border: none; color: #858585; cursor: pointer; font-size: 13px; font-weight: 500; border-left: 2px solid transparent; transition: all 0.2s ease; }
    .tab-btn svg { width: 18px; height: 18px; flex-shrink: 0; }
    .tab-btn:hover { background-color: #2d2d30; color: #cccccc; }
    .tab-btn.active { background-color: #2d2d30; border-left-color: #007acc; color: #007acc; }
    .center-workspace { background-color: #1e1e1e; display: flex; flex-direction: column; overflow: hidden; }
    #workspace-content { flex: 1; overflow: auto; padding: 20px; }
    .site-tab-content { width: 100%; height: 100%; }
    #siteMap { border-radius: 4px; border: 1px solid #3e3e42; width: 100%; height: 100%; }
    .shapes-tab-content { width: 100%; height: 100%; display: flex; flex-direction: column; overflow-y: auto; }
    .shapes-library-header { padding-bottom: 16px; border-bottom: 1px solid #3e3e42; }
    .shapes-library-header h2 { margin: 0 0 8px 0; font-size: 18px; font-weight: 600; }
    .shapes-info { margin: 0; font-size: 12px; color: #858585; }
    .generated-shapes-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 16px; padding-top: 16px; flex: 1; }
    .optimization-tab-content { width: 100%; display: flex; flex-direction: column; gap: 20px; overflow-y: auto; }
    .optimization-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #3e3e42; padding-bottom: 12px; }
    .optimization-header h2 { margin: 0; font-size: 18px; font-weight: 600; }
    .sort-filter { display: flex; gap: 8px; }
    .sort-btn, .filter-btn { padding: 6px 12px; background-color: #252526; border: 1px solid #3e3e42; color: #cccccc; cursor: pointer; border-radius: 3px; font-size: 12px; }
    .sort-btn:hover, .filter-btn:hover { background-color: #2d2d30; }
    .optimization-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; }
    .option-card { border: 1px solid #3e3e42; border-radius: 4px; padding: 12px; background-color: #252526; cursor: pointer; }
    .option-card:hover { border-color: #007acc; }
    .option-thumbnail { width: 100%; aspect-ratio: 1; background-color: #2d2d30; border-radius: 3px; margin-bottom: 12px; }
    .option-info h4 { margin: 0 0 8px 0; font-size: 13px; font-weight: 600; }
    .option-info p { margin: 4px 0; font-size: 12px; color: #858585; }
    .compare-tab-content { width: 100%; display: flex; flex-direction: column; gap: 16px; overflow-y: auto; }
    .compare-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #3e3e42; padding-bottom: 12px; }
    .compare-header h2 { margin: 0; font-size: 18px; }
    .compare-table { overflow-x: auto; }
    .compare-table table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .compare-table th { background-color: #252526; border-bottom: 2px solid #007acc; padding: 8px; text-align: left; font-weight: 600; color: #007acc; }
    .compare-table td { padding: 8px; border-bottom: 1px solid #3e3e42; }
    .right-sidebar { background-color: #252526; border-left: 1px solid #3e3e42; display: flex; flex-direction: column; overflow-y: auto; padding: 16px; }
    .ai-prompt-panel { display: flex; flex-direction: column; gap: 16px; height: 100%; }
    .panel-header h3 { margin: 0; font-size: 16px; font-weight: 600; color: #007acc; }
    .panel-content { flex: 1; display: flex; flex-direction: column; gap: 12px; overflow-y: auto; }
    .prompt-section { display: flex; flex-direction: column; gap: 12px; }
    .ai-message { font-size: 13px; color: #cccccc; line-height: 1.5; margin: 0; padding: 8px; background-color: #2d2d30; border-radius: 3px; border-left: 2px solid #007acc; }
    .prompt-input, .prompt-textarea { padding: 8px 12px; background-color: #2d2d30; border: 1px solid #3e3e42; color: #cccccc; border-radius: 3px; font-family: inherit; font-size: 12px; width: 100%; box-sizing: border-box; }
    .prompt-input:focus, .prompt-textarea:focus { outline: none; border-color: #007acc; }
    .prompt-textarea { resize: vertical; min-height: 80px; }
    .prompt-button { padding: 8px 16px; background-color: #007acc; border: none; color: white; border-radius: 3px; cursor: pointer; font-size: 13px; font-weight: 500; }
    .prompt-button:hover { background-color: #005a9e; }
    .type-btn, .tool-btn { padding: 8px 12px; background-color: #2d2d30; border: 1px solid #3e3e42; color: #cccccc; cursor: pointer; border-radius: 3px; font-size: 12px; text-align: left; width: 100%; }
    .type-btn:hover, .tool-btn:hover { background-color: #252526; border-color: #007acc; color: #007acc; }
    .building-types, .boundary-tools { display: flex; flex-direction: column; gap: 8px; }
    ::-webkit-scrollbar { width: 10px; }
    ::-webkit-scrollbar-track { background: #252526; }
    ::-webkit-scrollbar-thumb { background: #3e3e42; border-radius: 5px; }
    ::-webkit-scrollbar-thumb:hover { background: #007acc; }
  </style>
</head>
<body>
  <div id="appRoot"></div>
  <div id="popup" class="popup hidden"></div>
  
  <!-- Viewer Scripts -->
  <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.160.0/examples/js/controls/TransformControls.js"></script>
  <script src="/static/viewer.js?v=5"></script>
  
  <!-- Existing Components -->
  <script src="/static/components/EditToolbar.js"></script>
  <script src="/static/components/GeometrySelectionManager.js"></script>
  <script src="/static/components/TransformControlsManager.js"></script>
  <script src="/static/components/ManipulationControlsPanel.js"></script>
  <script src="/static/components/SelectionModePanel.js"></script>
  <script src="/static/components/PromptEditPanel.js"></script>
  <script src="/static/components/ClarificationDialog.js"></script>
  <script src="/static/components/ValidationPopup.js"></script>
  <script src="/static/components/EditingInitializer.js"></script>
  
  <!-- Main App -->
  <script type="module" src="/static/app.js?v=22"></script>
</body>
</html>
