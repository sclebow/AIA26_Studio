# TerraPilot Copilot — LLM provider configuration.
#
# The /copilot orchestrator uses an LLM to interpret free-form chat into workflow
# actions. If LLM_PROVIDER is unset (or the LLM errors), it transparently falls
# back to a deterministic rule-based resolver, so the app works with no key.
#
# Set ONE provider below.

# LLM_PROVIDER: one of  anthropic | openai | google | cloudflare | local
LLM_PROVIDER=anthropic

# --- anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
# Recommended: claude-sonnet-4-6 (fast) or claude-opus-4-8 (most capable)
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- openai ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- google (Gemini, OpenAI-compatible endpoint) ---
# GOOGLE_API_KEY=...
# GOOGLE_MODEL=gemini-2.0-flash

# --- cloudflare workers ai ---
# CF_API_TOKEN=...
# CF_ACCOUNT_ID=...
# CF_MODEL=@cf/meta/llama-3.1-8b-instruct

# --- local (OpenAI-compatible endpoint, e.g. Ollama / LM Studio) ---
# LOCAL_LLM_ENDPOINT=http://localhost:11434/v1
